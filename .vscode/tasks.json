{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Interpret current file with GS.g4",
      "detail": "Launches a GUI showing the parse result of parsing ${fileBasename}",
      "type": "shell",
      "command": "antlr4-parse",
      "windows": {
        "command": ".antlr4\\antlr4-parse.cmd"
      },
      "args": [
        "lib/FredrikHr.AuranGameScript.LanguageSyntax/GS.g4",
        "program",
        "-gui",
        "${file}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Parse all files in folder with GS.g4",
      "type": "shell",
      "windows": {
        "command": ".antlr4\\antlr4-interpreter-folder.cmd"
      },
      "args": [
        "${fileDirname}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Solution",
      "type": "dotnet",
      "task": "build",
      "group": { "isDefault": true, "kind": "build" },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": true
      },
    },
    {
      "label": "Clean Solution",
      "type": "dotnet",
      "task": "clean",
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": true
      },
    }
  ]
}
